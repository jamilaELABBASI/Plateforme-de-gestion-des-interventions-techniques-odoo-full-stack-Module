<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="intervention_search" model="ir.ui.view">
        <field name="name">intervention.search</field>
        <field name="model">intervention.management</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="client_id"/>
                <field name="technicien_id"/>
                
                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_assigned" string="Assigned" domain="[('state','=','assigned')]"/>
                <filter name="filter_in_progress" string="In Progress" domain="[('state','=','in_progress')]"/>
                <filter name="filter_done" string="Done" domain="[('state','=','done')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
            </search>
        </field>
    </record>
</odoo>
