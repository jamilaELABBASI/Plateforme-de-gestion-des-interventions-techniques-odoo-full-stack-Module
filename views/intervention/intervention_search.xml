<odoo>
    <record id="intervention_search" model="ir.ui.view">
        <field name="name">intervention.search</field>
        <field name="model">intervention.management</field>
        <field name="arch" type="xml">

            <search>

            <!-- Champs de recherche -->
            <field name="name" string="Nom"/>
            <field name="technicien_id"/>
            <field name="client_id"/>

            <!-- Filtres -->

            <filter name="filter_nouveau"
                    string="Nouveau"
                    domain="[('statut','=','nouveau')]"/>

            <filter name="filter_encours"
                    string="En cours"
                    domain="[('statut','=','en_cours')]"/>

            <filter name="filter_terminee"
                    string="Terminee"
                    domain="[('statut','=','terminee')]"/>

            <filter name="filter_today"
                    string="Aujourd hui"
                    domain="[('date_creation_intervention','=',context_today())]"/>

            <filter name="recent"
                    string="Plus recent"
                    domain="[]"
                    context="{'order':'date_creation_intervention desc'}"
            />

            <filter name="old"
                    string="Plus ancien"
                    context="{'order':'date_creation_intervention asc'}"
            />
        </search>
        </field>
    </record>
</odoo>