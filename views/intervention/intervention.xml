<odoo>

    <record id="intervention_list" model="ir.ui.view">
        <field name="name">intervention.list</field>
        <field name="model">intervention.management</field>
        <field name="arch" type="xml">

            <list decoration-success="priorite == 'basse'"
                  decoration-warning="priorite == 'moyenne'"
                  decoration-danger="is_late == True">
                <field name="name"/>
                <field name="cost"/>
                <field name="description"/>
                <field name="date_creation_intervention"/>
                <field name="date_resolution_intervention" invisible="statut != 'terminee'"/>
                <field name="statut" widget="badge"/>
                <field name="priorite" widget="priority"/>
                <field name="technicien_id"/>
                <field name="client_id"/>
                <field name="comment"/>
            </list>
        </field>
    </record>

    <record id="intervention_form" model="ir.ui.view">
        <field name="name">intervention.form</field>
        <field name="model">intervention.management</field>
        <field name="arch" type="xml">
            <form class="form_intervention">

                <header>
                    <field name="statut" widget="statusbar" statusbar_visible="en_cours,terminee,annulee"/>
                    <button class="button" name="statut_encours" string="Démarrer" type="object" invisible="not id or statut in ('en_cours','terminee','annulee')"/>
                    <button class="button" name="statut_terminee" string="Terminer" type="object" invisible="not id  or statut in ('terminee','annulee')"/> <!-- or statut in ('nouveau','annulee') -->
                    <button class="button" name="statut_annulee" string="Annuler" type="object" invisible="not id or statut in ('annulee') "/>
                </header>

                <sheet>
                    <group string="Statistiques">
                        <field name="total_interventions" readonly="1"/>
                        <field name="interventions_nouveaus" readonly="1"/>
                        <field name="interventions_terminees" readonly="1"/>
                        <field name="interventions_en_cours" readonly="1"/>
                        <field name="interventions_annulee" readonly="1"/>
                    </group>
                    <group string="Information" class="center_group_title" >
                        <field name="name"/>
                        <field name="description"/>
                        <field name="priorite" widget="priority" />
                        <field name="statut"  />
                        <field name="resolution_time"/>
                        <field name="estimated_time"/>
                        <field name="cost"/>
                    </group>

                    <group string="Gestion" class="center_group_title">
                        <field name="technicien_id"/>
                        <field name="client_id"/>
                        <field name="date_creation_intervention" />
                        <field name="date_resolution_intervention"/>
                    </group>

                    <group string="Suivi technicien" class="center_group_title" invisible="statut != 'terminee'">
                        <field name="comment" required="statut == 'terminee'"/>
                    </group>

                    <group string="photo" class="center_group_title">
                        <field name="before_picture" required="True"/>
                        <field name="after_picture" invisible="statut != 'terminee'" required="statut=='terminee'"/>
                    </group>

                    <group class="center_group_title">
                        <button name="ouvrir_maps"
                            string="Voir sur la carte"
                            type="object"
                            invisible="not client_id or not client_id.contact_address"/>
                    </group>

                    <group>
                        <field name="signature_client" widget="signature"/>
                        <field name="signature_technicien" widget="signature"/>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>



</odoo>