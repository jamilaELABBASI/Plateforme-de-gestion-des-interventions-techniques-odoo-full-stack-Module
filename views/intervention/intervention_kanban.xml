<odoo>

    <record id="view_intervention_kanban" model="ir.ui.view">
        <field name="name">intervention.management.kanban</field>
        <field name="model">intervention.management</field>
        <field name="arch" type="xml">

            <kanban>

                <!-- Champs utilisés dans la carte -->
                <field name="reference"/>
                <field name="name"/>
                <field name="client_id"/>
                <field name="state"/>
                <field name="priorite"/>
                <field name="description"/>

                <templates>
                    <t t-name="card">

                        <div class="oe_kanban_global_click">

                            <div class="row">
                                <div class="col-12">
                                    <strong>
                                        <field name="priorite"/>
                                    </strong>
                                </div>
                            </div>

                            <hr/>

                            <div>
                                <strong>Intervention :</strong>
                                <field name="name"/>
                            </div>

                            <div>
                                <strong>Client :</strong>
                                <field name="client_id"/>
                            </div>

                            <div>
                                <strong>Priorité :</strong>
                                <field name="priorite"/>
                            </div>

                            <div>
                                <strong>Statut :</strong>
                                <field name="state"/>
                            </div>

                            <div t-if="record.description.value">
                                <strong>Description :</strong>
                                <field name="description"/>
                            </div>

                        </div>

                    </t>
                </templates>

            </kanban>

        </field>
    </record>


</odoo>