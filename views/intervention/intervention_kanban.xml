<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="intervention_kanban_view" model="ir.ui.view">
        <field name="name">intervention.kanban</field>
        <field name="model">intervention.management</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="reference"/>
                <field name="client_id"/>
                <field name="technicien_id"/>
                <field name="state"/>
                <field name="date_creation_intervention"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('intervention.management', 'image_128', record.id.raw_value)" alt="Intervention" class="o_image_128_cover"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="reference"/>
                                </strong>
                                <div class="text-muted o_kanban_record_subtitle">
                                    <field name="name"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="client_id"/>
                                    <field name="technicien_id"/>
                                    <field name="date_creation_intervention"/>
                                    <field name="state" widget="badge"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
