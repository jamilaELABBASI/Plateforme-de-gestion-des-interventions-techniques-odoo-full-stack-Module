<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="intervention_email_technicien" model="mail.template">
        <field name="name">Affectation Intervention Technicien</field>
        <field name="model_id" ref="model_intervention_management"/>
        <field name="subject">Nouvelle intervention : ${object.reference}</field>
        <field name="email_from">${user.email_formatted}</field>
        <field name="email_to">${object.technicien_id.email}</field>
        <field name="body_html">
            <![CDATA[
                <p>Bonjour ${object.technicien_id.name},</p>
                <p>Une nouvelle intervention vous a été affectée.</p>
                <p><b>Référence :</b> ${object.reference}</p>
                <p><b>Client :</b> ${object.client_id.name}</p>
                <p><b>Équipement :</b> ${object.equipement_id.name}</p>
                <p>Cordialement.</p>
            ]]>
        </field>
    </record>
</odoo>
