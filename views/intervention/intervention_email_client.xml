<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="intervention_email_client" model="mail.template">
        <field name="name">Test</field>
        <field name="model_id" ref="model_intervention_management"/>
        <field name="subject">Confirmation d'intervention : ${object.reference}</field>
        <field name="email_from">${user.email_formatted}</field>
        <field name="email_to">${object.client_id.email}</field>
        <field name="body_html">
            <![CDATA[
                <p>Bonjour ${object.client_id.name},</p>
                <p>Votre demande d'intervention a bien été enregistrée.</p>
                <ul>
                    <li><b>Référence :</b> ${object.reference}</li>
                    <li><b>Technicien :</b> ${object.technicien_id.name}</li>
                </ul>
                <p>Nous vous contacterons dès que possible.</p>
                <p>Cordialement,<br/>
                Service Gestion des Interventions</p>
            ]]>
        </field>
    </record>
</odoo>
