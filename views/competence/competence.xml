<odoo>
    <record id="competence_list" model="ir.ui.view">
        <field name="name">competence.list</field>
        <field name="model">competence.management</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>

        </field>
    </record>

    <record id="competence_form" model="ir.ui.view">
        <field name="name">competence.form</field>
        <field name="model">competence.management</field>
        <field name="arch" type="xml">
            <form>
                 <sheet>
                     <group>
                         <field name="name"/>
                        <field name="description"/>
                        <field name="technicien_ids" widget="many2many_tags"/>
                     </group>
                 </sheet>
                <notebook>
                    <page string="Techniciens">
                        <field name="technicien_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="competences" widget="many2many_tags"/>
                                </list>
                        </field>
                    </page>
                </notebook>
            </form>
        </field>

    </record>
</odoo>