<odoo>

    <template id="report_intervention_template">

        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">

                <div class="page">

                    <!-- En-tête -->
                    <div style="text-align:center; margin-bottom:20px;">
                        <h2>Rapport d'Intervention</h2>
                        <hr/>
                    </div>

                    <!-- Informations générales -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:20px;">
                        <tr>
                            <td style="font-weight:bold; width:30%;">Nom :</td>
                            <td>
                                <span t-field="doc.name"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="font-weight:bold;">Client :</td>
                            <td>
                                <span t-field="doc.client_id"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="font-weight:bold;">Date :</td>
                            <td>
                                <span t-field="doc.date_creation_intervention"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="font-weight:bold;">Statut :</td>
                            <td>
                                <span t-field="doc.statut"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Description -->
                    <div style="margin-top:20px;">
                        <h4>Description</h4>
                        <div style="font-weight:bold;">
                            <span t-field="doc.description"/>
                        </div>
                    </div>

                    <!-- Signature -->
                    <div style="margin-top:60px;">
                        <table style="width:100%; margin-top:40px;">
                                <tr>
                                    <td style="width:50%; text-align:center;">
                                        <strong>Signature du technicien</strong><br/><br/>
                                        <img t-if="doc.signature_technicien"
                                             t-att-src="image_data_uri(doc.signature_technicien)"
                                             style="max-height:100px; max-width:200px;"/>
                                    </td>

                                    <td style="width:50%; text-align:center;">
                                        <strong>Signature du client</strong><br/><br/>
                                        <img t-if="doc.signature_client"
                                             t-att-src="image_data_uri(doc.signature_client)"
                                             style="max-height:100px; max-width:200px;"/>
                                    </td>
                                </tr>
                            </table>
                    </div>

                </div>

            </t>
        </t>

    </template>

</odoo>