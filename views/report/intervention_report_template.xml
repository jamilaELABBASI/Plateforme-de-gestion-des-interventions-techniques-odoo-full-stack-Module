<odoo>

    <template id="report_intervention_template">

        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">

                <div class="page">

                    <!-- En-tête -->
                    <div style="text-align:center; margin-bottom:20px;">
                        <h2>Rapport d'Intervention</h2>
                        <hr/>
                    </div>

                    <!-- Informations générales -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:20px;">
                        <tr>
                            <td style="font-weight:bold; width:30%;">Nom :</td>
                            <td>
                                <span t-field="doc.name"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="font-weight:bold;">Client :</td>
                            <td>
                                <span t-field="doc.client_id"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="font-weight:bold;">Date :</td>
                            <td>
                                <span t-field="doc.date_intervention"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="font-weight:bold;">Statut :</td>
                            <td>
                                <span t-field="doc.statut"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Description -->
                    <div style="margin-top:20px;">
                        <h4>Description</h4>
                        <div style="border:1px solid #000; padding:10px;">
                            <span t-field="doc.description"/>
                        </div>
                    </div>

                    <!-- Signature -->
                    <div style="margin-top:60px;">
                        <table style="width:100%;">
                            <tr>
                                <td style="text-align:left;">
                                    Signature Technicien
                                </td>
                                <td style="text-align:right;">
                                    Signature Client
                                </td>
                            </tr>
                        </table>
                    </div>

                </div>

            </t>
        </t>

    </template>

</odoo>